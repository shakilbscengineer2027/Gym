datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  TRAINER
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  PENDING_DELETION
}

enum MuscleGroup {
  CHEST
  BACK_LATS
  BACK_UPPER
  BACK_LOWER
  SHOULDERS_ANTERIOR
  SHOULDERS_LATERAL
  SHOULDERS_POSTERIOR
  BICEPS
  TRICEPS
  FOREARMS
  QUADRICEPS
  HAMSTRINGS
  GLUTES
  CALVES
  ABDOMINALS
  OBLIQUES
  CARDIOVASCULAR
  FULL_BODY
}

enum EquipmentType {
  BARBELL
  DUMBBELL
  KETTLEBELL
  MACHINE
  CABLE
  BODYWEIGHT
  RESISTANCE_BAND
  SMITH_MACHINE
  OTHER
}

enum SetType {
  WARMUP
  NORMAL
  DROPSET
  MYO_REP
  FAILURE
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ABANDONED
}

enum SubscriptionTier {
  FREE
  PRO_ATHLETE_MONTHLY
  PRO_ATHLETE_ANNUAL
  TRAINER_TIER
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  UNPAID
}

// ==========================================
// 1. AUTH & USERS
// ==========================================
model User {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String
  role            UserRole       @default(USER)
  status          AccountStatus  @default(ACTIVE)
  emailVerified   Boolean        @default(false)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  profile         Profile?
  refreshTokens   RefreshToken[]
  consents        UserConsent[]
  auditLogs       AuditLog[]
  workoutSessions WorkoutSession[]
  workoutTemplates WorkoutTemplate[]
  schedules       ScheduleEvent[]
  nutritionGoals  NutritionGoal[]
  dailyNutrition  DailyNutrition[]
  waterLogs       WaterLog[]
  bodyMeasurements BodyMeasurement[]
  personalRecords PersonalRecord[]
  notifications   Notification[]
  posts           CommunityPost[]
  postLikes       PostLike[]
  postComments    PostComment[]
  achievements    UserAchievement[]
  subscription    UserSubscription?
  trainerProfile  TrainerProfile?
  clientRelations TrainerClientAssignment[] @relation("ClientAssignments")

  @@index([email])
  @@index([status, deletedAt])
}

model Profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  displayName     String
  avatarUrl       String?
  bio             String?
  experienceLevel String   @default("Beginner")
  primaryGoal     String   @default("Hypertrophy")
  preferredUnit   String   @default("METRIC")
  heightCm        Float?
  birthDate       DateTime?
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  familyId   String
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRevoked])
  @@index([tokenHash])
}

// ==========================================
// 2. EXERCISES & CATALOG
// ==========================================
model Exercise {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  primaryMuscle MuscleGroup
  equipment     EquipmentType
  instructions  String?        @db.Text
  thumbnailUrl  String?
  videoUrl      String?
  isCustom      Boolean        @default(false)
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  templateItems WorkoutTemplateExercise[]
  sessionSets   SetLog[]
  personalRecords PersonalRecord[]

  @@index([primaryMuscle])
  @@index([equipment])
}

// ==========================================
// 3. WORKOUTS, TEMPLATES & ACTIVE SESSIONS
// ==========================================
model WorkoutTemplate {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  category    String   @default("Strength")
  fitnessLevel String  @default("Advance")
  durationMinutes Int  @default(60)
  isPublic    Boolean  @default(false)
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises   WorkoutTemplateExercise[]
  sessions    WorkoutSession[]

  @@index([userId, deletedAt])
}

model WorkoutTemplateExercise {
  id                String          @id @default(uuid())
  workoutTemplateId String
  exerciseId        String
  sortOrder         Int             @default(1)
  targetSets        Int             @default(3)
  targetReps        Int             @default(10)
  targetWeightKg    Float?
  restSeconds       Int             @default(90)

  workoutTemplate   WorkoutTemplate @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  exercise          Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([workoutTemplateId, sortOrder])
}

model WorkoutSession {
  id                String               @id @default(uuid())
  userId            String
  workoutTemplateId String?
  name              String
  status            WorkoutSessionStatus @default(IN_PROGRESS)
  startedAt         DateTime             @default(now())
  endedAt           DateTime?
  durationSeconds   Int                  @default(0)
  totalVolumeKg     Float                @default(0)
  clientMutationId  String?              @unique
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  template          WorkoutTemplate?     @relation(fields: [workoutTemplateId], references: [id], onDelete: SetNull)
  setLogs           SetLog[]

  @@index([userId, startedAt])
  @@index([status])
}

model SetLog {
  id               String         @id @default(uuid())
  workoutSessionId String
  exerciseId       String
  setNumber        Int
  setType          SetType        @default(NORMAL)
  weightKg         Float
  reps             Int
  rpe              Float?
  isCompleted      Boolean        @default(true)
  completedAt      DateTime       @default(now())

  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([workoutSessionId, exerciseId])
}

// ==========================================
// 4. CALENDAR & SCHEDULING
// ==========================================
model ScheduleEvent {
  id                String    @id @default(uuid())
  userId            String
  workoutTemplateId String?
  title             String
  scheduledDate     DateTime  @db.Date
  scheduledTime     String?
  isCompleted       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledDate])
}

// ==========================================
// 5. NUTRITION & WATER INTAKE
// ==========================================
model NutritionGoal {
  id            String   @id @default(uuid())
  userId        String   @unique
  dailyCalories Int      @default(2500)
  proteinGrams  Int      @default(180)
  carbGrams     Int      @default(250)
  fatGrams      Int      @default(70)
  waterMlTarget Int      @default(3000)
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyNutrition {
  id           String   @id @default(uuid())
  userId       String
  date         DateTime @db.Date
  calories     Int      @default(0)
  proteinGrams Float    @default(0)
  carbGrams    Float    @default(0)
  fatGrams     Float    @default(0)
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals        MealEntry[]

  @@unique([userId, date])
}

model MealEntry {
  id               String         @id @default(uuid())
  dailyNutritionId String
  mealType         String         // BREAKFAST, LUNCH, DINNER, SNACK
  name             String
  calories         Int
  proteinGrams     Float
  carbGrams        Float
  fatGrams         Float
  createdAt        DateTime       @default(now())

  dailyNutrition   DailyNutrition @relation(fields: [dailyNutritionId], references: [id], onDelete: Cascade)
}

model WaterLog {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  amountMl  Int      @default(250)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ==========================================
// 6. BODY MEASUREMENTS & ANALYTICS
// ==========================================
model BodyMeasurement {
  id             String   @id @default(uuid())
  userId         String
  recordedDate   DateTime @db.Date
  weightKg       Float
  bodyFatPercent Float?
  chestCm        Float?
  waistCm        Float?
  leftArmCm      Float?
  rightArmCm     Float?
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedDate])
}

model PersonalRecord {
  id           String   @id @default(uuid())
  userId       String
  exerciseId   String
  recordType   String   // ESTIMATED_1RM, MAX_WEIGHT
  value        Float
  achievedDate DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise     Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([userId, exerciseId, recordType])
}

// ==========================================
// 7. TRAINERS & COACHING
// ==========================================
model TrainerProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  specialization String
  certification  String
  isVerified     Boolean  @default(false)
  hourlyRate     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients        TrainerClientAssignment[] @relation("TrainerAssignments")
}

model TrainerClientAssignment {
  id               String         @id @default(uuid())
  trainerProfileId String
  clientId         String
  status           String         @default("ACCEPTED") // PENDING, ACCEPTED
  assignedAt       DateTime       @default(now())

  trainerProfile   TrainerProfile @relation("TrainerAssignments", fields: [trainerProfileId], references: [id], onDelete: Cascade)
  client           User           @relation("ClientAssignments", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([trainerProfileId, clientId])
}

// ==========================================
// 8. NOTIFICATIONS, COMMUNITY & ACHIEVEMENTS
// ==========================================
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model CommunityPost {
  id           String        @id @default(uuid())
  userId       String
  content      String        @db.Text
  likesCount   Int           @default(0)
  createdAt    DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes        PostLike[]
  comments     PostComment[]

  @@index([createdAt])
}

model PostLike {
  id        String        @id @default(uuid())
  postId    String
  userId    String
  createdAt DateTime      @default(now())

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model PostComment {
  id        String        @id @default(uuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime      @default(now())

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Achievement {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String
  badgeIcon   String
  points      Int      @default(100)

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// ==========================================
// 9. SUBSCRIPTIONS, GDPR & AUDIT
// ==========================================
model UserSubscription {
  id                 String             @id @default(uuid())
  userId             String             @unique
  tier               SubscriptionTier   @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  provider           String             @default("STRIPE")
  currentPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserConsent {
  id            String   @id @default(uuid())
  userId        String
  consentType   String
  granted       Boolean  @default(true)
  timestamp     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  ipHash    String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
}
